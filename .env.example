# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# Optional: enables suggested two-gear MNQ sizing + a paper account in the alerts
ACCOUNT_EQUITY=
# yahoo (default, ~10 min delayed) | yahoo:MNQ=F | csv:/path/to/bars.csv (real-time bridge)
# | tradovate (real-time NQ front month) | tradovate:MNQ | tradovate:NQZ6 (explicit contract)
PROVIDER=yahoo
HIGH_PRECISION=1
STATE_DIR=state

# --- Tradovate (PROVIDER=tradovate). Never commit these; in GitHub use repo secrets. ---
# Unattended (recommended): your Tradovate login + API key
TRADOVATE_NAME=
TRADOVATE_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=
# Or, for a quick manual test only (expires ~90 min after it was issued, renewed while the bot runs)
TRADOVATE_ACCESS_TOKEN=
TRADOVATE_ENV=live
# Optional: pin a contract instead of the auto front month (rolls 8 days before expiry)
TRADOVATE_SYMBOL=
