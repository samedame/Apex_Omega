// This Pine Script™ v5 code is subject to the terms of the Mozilla Public License 2.0
// © APEX-OMEGA Quantitative Futures Lab (1-Minute MNQ / NQ Master Engine)
//@version=5
strategy("APEX-OMEGA 6-Pillar 1m Futures Engine [$1.5k -> $100k+]", overlay=true, initial_capital=1500, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0.62, slippage=1, calc_on_every_tick=false, process_orders_on_close=false)

// =============================================================================
// 1. USER INPUTS & CAPITAL SCALING SETTINGS
// =============================================================================
grp_cap = "1. Two-Gear Capital Scaling ($1,500 -> $100,000+)"
use_two_gear   = input.bool(true, "Enable Two-Gear Optimal Compounding", group=grp_cap)
gear1_ceil     = input.float(2050.0, "Gear-1 Survival Ceiling ($ Equity)", group=grp_cap)
base_risk_pct  = input.float(6.5, "Gear-2 Base Risk % per Trade", minval=0.5, maxval=15.0, step=0.5, group=grp_cap) / 100.0
pt_value       = input.float(2.0, "Point Value ($2.00 for MNQ, $20.00 for NQ)", group=grp_cap)
margin_per_c   = input.float(100.0, "Intraday Margin per Contract ($)", group=grp_cap)
max_contracts  = input.int(800, "Maximum Contract Cap (MNQ Equivalent)", group=grp_cap)
high_prec_mode = input.bool(true, "High-Precision Core Mode (Filter Wide P2 Stops > 28pts)", group=grp_cap)

grp_pil = "2. Active Intraday Alpha Pillars (America/New_York)"
en_p1 = input.bool(true, "Pillar 1: 10m Opening Drive + EMA9 Pullback (09:41-11:45 ET)", group=grp_pil)
en_p2 = input.bool(true, "Pillar 2: 5m Delta+VWAP ORB Breakout (09:35-10:15 ET)", group=grp_pil)
en_p3 = input.bool(true, "Pillar 3: 15m Asymmetric Regime ORB (09:45-11:00 ET)", group=grp_pil)
en_p4 = input.bool(true, "Pillar 4: 20m HTF-SMA20 Aligned ORB (09:50-11:05 ET)", group=grp_pil)
en_p5 = input.bool(true, "Pillar 5: Session VWAP +/-3.0 SD Rubber-Band (10:15-14:55 ET)", group=grp_pil)
en_p6 = input.bool(true, "Pillar 6: Afternoon NSH/NSL + EMA9 Pullback (13:30-15:25 ET)", group=grp_pil)

// =============================================================================
// 2. CAUSAL 1-MINUTE & DAILY REGIME INDICATORS
// =============================================================================
ny_hour = hour(time, "America/New_York")
ny_min  = minute(time, "America/New_York")
hm      = ny_hour * 60 + ny_min
is_rth  = hm >= 570 and hm < 960
is_new_rth = is_rth and not is_rth[1]

ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
atr14  = ta.atr(14)
rsi5   = ta.rsi(close, 5)
vol_ma = ta.sma(volume, 20)
rvol   = volume / math.max(vol_ma, 1.0)
rng    = high - low
clv    = rng > 0 ? (2.0 * close - high - low) / rng : 0.0

// Daily SMA20 & Daily ATR14 (strictly non-repainting prior-day values)
[d_sma20, d_atr14] = request.security(syminfo.tickerid, "D", [ta.sma(close[1], 20), ta.atr(14)[1]], lookahead=barmerge.lookahead_off)

// Session Anchored VWAP, VWAP StdDev, Cumulative Delta Proxy, and Opening Ranges
var float cum_pv   = 0.0
var float cum_p2v  = 0.0
var float cum_v    = 0.0
var float cum_del  = 0.0
var float rth_open = na
var float orb5_h   = na, var float orb5_l  = na
var float orb15_h  = na, var float orb15_l = na
var float orb20_h  = na, var float orb20_l = na
var float sess_h   = na, var float sess_l  = na
var float c_10m    = na, var float atr_10m = na
var float c_30m    = na, var float atr_30m = na
var bool  p1_done  = false, var bool p2_done = false, var bool p3_done = false
var bool  p4_done  = false, var bool p5_done = false, var bool p6_done = false

if is_new_rth
    cum_pv   := 0.0
    cum_p2v  := 0.0
    cum_v    := 0.0
    cum_del  := 0.0
    rth_open := open
    orb5_h   := high, orb5_l  := low
    orb15_h  := high, orb15_l := low
    orb20_h  := high, orb20_l := low
    sess_h   := high, sess_l  := low
    c_10m    := na,   atr_10m := na
    c_30m    := na,   atr_30m := na
    p1_done  := false, p2_done := false, p3_done := false
    p4_done  := false, p5_done := false, p6_done := false

if is_rth
    typ      = (high + low + close) / 3.0
    cum_pv  += typ * volume
    cum_p2v += (typ * typ) * volume
    cum_v   += volume
    cum_del += clv * volume
    m_idx    = hm - 570
    if m_idx < 5
        orb5_h := math.max(orb5_h, high)
        orb5_l := math.min(orb5_l, low)
    if m_idx < 15
        orb15_h := math.max(orb15_h, high)
        orb15_l := math.min(orb15_l, low)
    if m_idx < 20
        orb20_h := math.max(orb20_h, high)
        orb20_l := math.min(orb20_l, low)
    if m_idx == 10
        c_10m   := close
        atr_10m := atr14
    if m_idx == 30
        c_30m   := close
        atr_30m := atr14

vwap_val = cum_v > 0 ? cum_pv / cum_v : close
vwap_var = cum_v > 0 ? math.max((cum_p2v / cum_v) - (vwap_val * vwap_val), 0.25) : 1.0
vwap_std = math.sqrt(vwap_var)

// Track session high/low up to 5 bars ago for Pillar 6
prior_sess_h = ta.highest(high[5], math.max(1, hm - 570 - 5))
prior_sess_l = ta.lowest(low[5], math.max(1, hm - 570 - 5))
rec_10m_h    = ta.highest(high, 10)
rec_10m_l    = ta.lowest(low, 10)

if is_rth
    sess_h := math.max(nz(sess_h, high), high)
    sess_l := math.min(nz(sess_l, low), low)

// =============================================================================
// 3. TWO-GEAR POSITION SIZING & DRAWDOWN GOVERNOR
// =============================================================================
var float peak_eq = strategy.initial_capital
cur_eq  = strategy.equity
peak_eq := math.max(peak_eq, cur_eq)
cur_dd  = peak_eq > 0 ? (peak_eq - cur_eq) / peak_eq : 0.0

f_calc_qty(float stop_pts, float p_weight) =>
    float risk_1c = stop_pts * pt_value
    int qty = 1
    if not use_two_gear
        qty := 1
    else if cur_eq < gear1_ceil
        qty := risk_1c <= 104.0 ? 1 : 0
    else
        float dd_mult = cur_dd > 0.30 ? 0.55 : (cur_dd > 0.18 ? 0.75 : 1.0)
        float rf = base_risk_pct * p_weight * dd_mult
        qty := math.max(1, int(math.round((cur_eq * rf) / risk_1c)))
        while qty > 1 and (qty * risk_1c) > (cur_eq * 0.105)
            qty -= 1
    int max_m = int(math.floor((cur_eq * 0.85) / margin_per_c))
    math.max(0, math.min(qty, math.min(max_m, max_contracts)))

// =============================================================================
// 4. SIX-PILLAR SIGNAL GENERATION & EXECUTION
// =============================================================================
m_idx = hm - 570
min_sl = math.max(1.0 * atr14, 10.0)
max_sl = math.min(math.max(3.8 * atr14, 35.0), 68.0)

var float active_sl = na
var float active_tp = na
var float active_entry = na
var float active_stop_dist = na
var float active_be_trig = na
var float active_be_lock = na

if is_rth and strategy.position_size == 0
    // Pillar 1: 10m Opening Drive + EMA9 Institutional Pullback
    if en_p1 and not p1_done and m_idx >= 11 and m_idx <= 135 and not na(c_10m)
        float drive10 = c_10m - rth_open
        if math.abs(drive10) >= 1.8 * atr_10m
            int d_dir = drive10 > 0 ? 1 : -1
            if d_dir == 1 and low <= ema9 and close > ema9 and clv > 0.40 and ema9 > ema21
                float sl_d = math.min(math.max((close - math.min(low, low[1])) + 0.75 * atr14, min_sl), max_sl)
                int q = f_calc_qty(sl_d, 1.30)
                if q > 0
                    strategy.entry("P1_OD_Long", strategy.long, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close - sl_d, active_tp := close + sl_d * 4.0
                    active_be_trig := 1.8, active_be_lock := 0.25, p1_done := true
            else if d_dir == -1 and high >= ema9 and close < ema9 and clv < -0.40 and ema9 < ema21
                float sl_d = math.min(math.max((math.max(high, high[1]) - close) + 0.75 * atr14, min_sl), max_sl)
                int q = f_calc_qty(sl_d, 1.30)
                if q > 0
                    strategy.entry("P1_OD_Short", strategy.short, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close + sl_d, active_tp := close - sl_d * 4.0
                    active_be_trig := 1.8, active_be_lock := 0.25, p1_done := true

    // Pillar 2: 5m Delta-Confirmed ORB
    if en_p2 and not p2_done and strategy.position_size == 0 and m_idx >= 5 and m_idx <= 45
        float orb5_rng = orb5_h - orb5_l
        float sl_d = math.min(math.max(orb5_rng * 0.75, min_sl), max_sl)
        bool pass_hp = not high_prec_mode or sl_d <= 28.0
        if pass_hp and orb5_rng >= 1.2 * atr14 and orb5_rng <= 0.45 * d_atr14
            if close > orb5_h and clv > 0.45 and close > vwap_val and cum_del > 0
                int q = f_calc_qty(sl_d, 0.90)
                if q > 0
                    strategy.entry("P2_ORB5_Long", strategy.long, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close - sl_d, active_tp := close + sl_d * 6.0
                    active_be_trig := 2.0, active_be_lock := 0.30, p2_done := true
            else if close < orb5_l and clv < -0.45 and close < vwap_val and cum_del < 0 and rvol > 1.30
                int q = f_calc_qty(sl_d, 0.90)
                if q > 0
                    strategy.entry("P2_ORB5_Short", strategy.short, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close + sl_d, active_tp := close - sl_d * 6.0
                    active_be_trig := 2.0, active_be_lock := 0.30, p2_done := true

    // Pillar 3: 15m Asymmetric Regime ORB
    if en_p3 and not p3_done and strategy.position_size == 0 and m_idx >= 15 and m_idx <= 90
        float orb15_rng = orb15_h - orb15_l
        float sl_d = math.min(math.max(orb15_rng * 1.0, min_sl), 68.0)
        if orb15_rng >= 1.2 * atr14 and orb15_rng <= 0.55 * d_atr14
            if close > orb15_h and clv > 0.45 and close > vwap_val
                int q = f_calc_qty(sl_d, 1.05)
                if q > 0
                    strategy.entry("P3_ORB15_Long", strategy.long, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close - sl_d, active_tp := close + sl_d * 6.0
                    active_be_trig := 2.0, active_be_lock := 0.30, p3_done := true
            else if close < orb15_l and clv < -0.45 and rth_open < d_sma20 and rvol > 1.40
                int q = f_calc_qty(sl_d, 1.05)
                if q > 0
                    strategy.entry("P3_ORB15_Short", strategy.short, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close + sl_d, active_tp := close - sl_d * 6.0
                    active_be_trig := 2.0, active_be_lock := 0.30, p3_done := true

    // Pillar 4: 20m HTF-SMA20 Aligned ORB
    if en_p4 and not p4_done and strategy.position_size == 0 and m_idx >= 20 and m_idx <= 95
        float orb20_rng = orb20_h - orb20_l
        float sl_d = math.min(math.max(orb20_rng * 0.75, min_sl), max_sl)
        if orb20_rng >= 1.2 * atr14 and orb20_rng <= 0.55 * d_atr14
            if close > orb20_h and clv > 0.45 and rth_open > d_sma20
                int q = f_calc_qty(sl_d, 1.10)
                if q > 0
                    strategy.entry("P4_ORB20_Long", strategy.long, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close - sl_d, active_tp := close + sl_d * 6.0
                    active_be_trig := 2.0, active_be_lock := 0.30, p4_done := true
            else if close < orb20_l and clv < -0.45 and rth_open < d_sma20
                int q = f_calc_qty(sl_d, 1.10)
                if q > 0
                    strategy.entry("P4_ORB20_Short", strategy.short, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close + sl_d, active_tp := close - sl_d * 6.0
                    active_be_trig := 2.0, active_be_lock := 0.30, p4_done := true

    // Pillar 5: Session VWAP +/-3.0 SD Rubber-Band Exhaustion Reversal
    if en_p5 and not p5_done and strategy.position_size == 0 and m_idx >= 45 and m_idx <= 325 and not na(c_30m)
        if math.abs(c_30m - rth_open) <= 2.8 * atr_30m
            float up_b = vwap_val + 3.0 * vwap_std
            float dn_b = vwap_val - 3.0 * vwap_std
            if low < dn_b and rsi5[1] < 20 and close > open and clv > 0.45 and rth_open > d_sma20
                float sl_d = math.min(math.max((close - low) + 0.8 * atr14, min_sl), max_sl)
                int q = f_calc_qty(sl_d, 0.95)
                if q > 0
                    strategy.entry("P5_VWAP_Long", strategy.long, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close - sl_d, active_tp := close + sl_d * 2.5
                    active_be_trig := na, active_be_lock := 0.0, p5_done := true
            else if high > up_b and rsi5[1] > 78 and close < open and clv < -0.45
                float sl_d = math.min(math.max((high - close) + 0.8 * atr14, min_sl), max_sl)
                int q = f_calc_qty(sl_d, 0.95)
                if q > 0
                    strategy.entry("P5_VWAP_Short", strategy.short, qty=q)
                    active_entry := close, active_stop_dist := sl_d
                    active_sl := close + sl_d, active_tp := close - sl_d * 2.5
                    active_be_trig := na, active_be_lock := 0.0, p5_done := true

    // Pillar 6: Afternoon New-Session-High/Low + EMA9 Pullback Continuation
    if en_p6 and not p6_done and strategy.position_size == 0 and m_idx >= 240 and m_idx <= 355
        if rec_10m_h >= prior_sess_h and low <= ema9 and close > ema9 and clv > 0.45 and ema9 > ema21 and close > vwap_val
            float sl_d = math.min(math.max((close - math.min(low, low[1])) + 0.8 * atr14, min_sl), max_sl)
            int q = f_calc_qty(sl_d, 1.10)
            if q > 0
                strategy.entry("P6_PM_Long", strategy.long, qty=q)
                active_entry := close, active_stop_dist := sl_d
                active_sl := close - sl_d, active_tp := close + sl_d * 4.5
                active_be_trig := 1.8, active_be_lock := 0.25, p6_done := true
        else if rec_10m_l <= prior_sess_l and high >= ema9 and close < ema9 and clv < -0.45 and ema9 < ema21 and close < vwap_val
            float sl_d = math.min(math.max((math.max(high, high[1]) - close) + 0.8 * atr14, min_sl), max_sl)
            int q = f_calc_qty(sl_d, 1.10)
            if q > 0
                strategy.entry("P6_PM_Short", strategy.short, qty=q)
                active_entry := close, active_stop_dist := sl_d
                active_sl := close + sl_d, active_tp := close - sl_d * 4.5
                active_be_trig := 1.8, active_be_lock := 0.25, p6_done := true

// Manage Breakeven Lock & Exits
if strategy.position_size > 0
    if not na(active_be_trig) and (high - active_entry) >= active_be_trig * active_stop_dist
        active_sl := math.max(active_sl, active_entry + active_be_lock * active_stop_dist)
    strategy.exit("Exit_L", stop=active_sl, limit=active_tp)
else if strategy.position_size < 0
    if not na(active_be_trig) and (active_entry - low) >= active_be_trig * active_stop_dist
        active_sl := math.min(active_sl, active_entry - active_be_lock * active_stop_dist)
    strategy.exit("Exit_S", stop=active_sl, limit=active_tp)

// Flat before 15:58 ET cash close (no overnight margin exposure!)
if hm >= 958 and strategy.position_size != 0
    strategy.close_all(comment="EOD_Flat_1558ET")

plot(is_rth ? vwap_val : na, "Session VWAP", color=color.new(color.yellow, 15), linewidth=2, style=plot.style_linebr)
plot(is_rth ? ema9 : na, "EMA 9", color=color.new(color.aqua, 20), linewidth=1, style=plot.style_linebr)
plot(is_rth ? ema21 : na, "EMA 21", color=color.new(color.fuchsia, 20), linewidth=1, style=plot.style_linebr)
